# ─── ARIX edu — пример конфигурации ───────────────────────────────────────────
# cp .env.example .env и заполните. Для демо достаточно значений по умолчанию:
# без ANTHROPIC_API_KEY бот работает на детерминированном движке и всё равно
# отвечает по курсам, записывает на пробный и ведёт счета.
#
# Порты сдвинуты относительно clinic-ai, чтобы оба стека жили на одной машине.

# ─── Окружение ────────────────────────────────────────────────────────────────
ENV=demo
VERTICAL=edu
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
# Внешний адрес бэкенда: именно он уходит в вебхуки Telegram и WhatsApp.
# Для локального демо поднимите туннель (ngrok / cloudflared) и укажите его тут.
PUBLIC_BASE_URL=http://localhost:8001
PUBLIC_API_BASE=http://localhost:8001
# 32+ символа. Используется для JWT и для шифрования токенов каналов.
SECRET_KEY=change-me-to-a-long-random-string-32b
# Токен суперадмина ARIX для /admin/* (заголовок X-Arix-Admin-Token).
ADMIN_API_TOKEN=dev-admin-token

# ─── Порты (меняйте, если заняты) ─────────────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=3002
WAWEB_PORT=3003
POSTGRES_PORT=5433

# ─── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=arix_edu
# Роль приложения — НЕ суперпользователь: от этого зависит работа RLS.
POSTGRES_USER=arix_app
POSTGRES_PASSWORD=arix
POSTGRES_SUPERUSER_PASSWORD=postgres
# Для центров Казахстана: инстанс БД должен физически стоять в РК (ТЗ §13).
DATA_REGION=local

# ─── LLM (Claude) ─────────────────────────────────────────────────────────────
# Пусто = детерминированный движок: демо и CI работают без сети и без ключа.
ANTHROPIC_API_KEY=
LLM_DIALOG_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=900
LLM_MAX_TOOL_ROUNDS=6
# true — принудительно использовать детерминированный движок даже с ключом.
LLM_FORCE_SCRIPTED=false

# ─── Голосовые сообщения ──────────────────────────────────────────────────────
# none | openai | local (faster-whisper на своём сервере — для KZ-тенантов)
STT_PROVIDER=none
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Общий бот ARIX: используется для демо, диплинков t_<slug> и для персонала.
TELEGRAM_SHARED_BOT_TOKEN=
# Секрет вебхука: Telegram присылает его в X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Внутренний бот ARIX для алертов (мёртвые задания, упавшие каналы).
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# baileys   — WhatsApp Web, центр привязывает свой номер по QR, без оплаты Meta
# cloud_api — официальный Meta Cloud API (шаблоны, платные сервисные сообщения)
WA_PROVIDER=baileys
WA_BAILEYS_URL=http://waweb:3000
WA_BAILEYS_TOKEN=change-me-baileys-token
WA_WEBHOOK_SECRET=change-me-wa-webhook-secret
# Пэйсинг отправки: неофициальный клиент нельзя использовать для рассылок.
WA_MIN_SEND_INTERVAL_MS=1200
WA_MAX_SEND_PER_MINUTE=20
# Только для cloud_api: порог бесплатной квоты сервисных сообщений.
WA_FREE_TIER_MONTHLY=1000

# ─── Персональные данные ──────────────────────────────────────────────────────
# Маскирование телефонов/ИИН/имён перед отправкой в LLM. Выключать нельзя
# для медицинских тенантов (ТЗ §13).
PII_MASKING_ENABLED=true
# Ключ шифрования учётных данных каналов (urlsafe base64, 32 байта).
# Сгенерировать: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ─── Планировщик ──────────────────────────────────────────────────────────────
JOB_POLL_INTERVAL_S=5
JOB_BATCH_SIZE=50
JOB_MAX_ATTEMPTS=5
HOLD_TTL_MINUTES=10

# ─── Демо ─────────────────────────────────────────────────────────────────────
DEMO_ENABLED=true
DEMO_TTL_DAYS=14
# true — ничего не отправляется наружу, все сообщения только пишутся в БД.
# Удобно для оффлайн-демо и для прогона eval.
CHANNELS_DRY_RUN=false
